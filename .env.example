# --- python-telegram-bot (the bot itself) ---
TG_BOT_TOKEN=your-bot-token-from-@BotFather

# --- Telethon userbot (uploads files >50MB through your user account) ---
TG_APP_API_ID=12345678
TG_APP_API_HASH=your-app-api-hash
TG_APP_SHORT_NAME=session_name        # name of the .session file Telethon creates
TG_APP_CHAT_ID=-1001234567890         # private storage chat the userbot forwards through

# --- Optional integrations ---
RASIFAL=https://keyvalue.hamropatro.com/kv/get/horoscope_daily::-1?v=2
X_RapidAPI_Key=                       # for Instagram-stories fallback
YT_APIV2=                             # currently unused; kept for future yt features

# --- Bot admins (comma-separated user IDs allowed to /broadcast) ---
ADMIN_USER_IDS=996638940
